# Production image for headscale.
#
# Unlike Dockerfile.integration (which builds a delve debug binary with
# -gcflags="all=-N -l", disabling optimisation and inlining), this builds a
# normal optimised binary suitable for production use.

FROM docker.io/golang:1.26-trixie AS build
ENV GOPATH=/go
WORKDIR /go/src/headscale

COPY go.mod go.sum /go/src/headscale/
RUN go mod download

COPY . .

# Note: `headscale version` reports "dev" here, which matches the image that
# was previously deployed. The version comes from Go build info, which needs
# the .git directory, and .dockerignore excludes it. The image tag and the
# OCI labels below are the source of truth for what is deployed.
RUN CGO_ENABLED=0 GOOS=linux go build \
      -trimpath \
      -buildvcs=false \
      -ldflags "-s -w" \
      -o /go/bin/headscale ./cmd/headscale

FROM docker.io/debian:trixie-slim

ARG VERSION=dev
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="headscale" \
      org.opencontainers.image.source="https://github.com/UbiqueInnovation/headscale" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.revision="$VCS_REF"

RUN apt-get update \
  && apt-get install --no-install-recommends --yes ca-certificates jq sqlite3 dnsutils \
  && rm -rf /var/lib/apt/lists/* \
  && apt-get clean \
  && mkdir -p /var/run/headscale

COPY --from=build /go/bin/headscale /usr/local/bin/headscale

ENTRYPOINT []
EXPOSE 8080/tcp
CMD ["headscale", "serve"]
